# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=5380                       # Technitium's web console
DNS_PORT=53                          # DNS for your network: 53, the standard port
LAN_IP=192.168.1.20                  # point your router's DNS (or your devices) at this
TZ=Europe/London
APP_URL=http://192.168.1.20:5380
SSL_PROXY=0
TN_IMAGE=technitium/dns-server:15.6.1 # pinned; the Updates tab moves it to a newer release
TN_TOKEN=…                           # the package's own API token (admin) — root-only file
TN_FIRST_PW=                         # the throwaway first password, until the first start has replaced it
TN_PFX_PW=…                          # password of the certificate file Technitium reads for HTTPS
RESOLVER=forward                     # forward | recursive
UPSTREAM=cloudflare                  # cloudflare | quad9 | google | custom
DNS_PROTO=https                      # https | tls | udp — how lookups go to the upstream
CUSTOM_DNS=                          # with custom: up to two addresses, + separated (plain DNS)
TLS=off                              # dsm | self | off — the web console
TLS_SOURCE=off
INNER_PORT=5380                      # 53443 when HTTPS is on
